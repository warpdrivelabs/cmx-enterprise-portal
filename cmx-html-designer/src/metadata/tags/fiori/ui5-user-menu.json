    },
    {
      "name": "opener",
      "label": "opener",
      "type": "text",
      "placeholder": "元素ID"
    },
    {
      "name": "show-manage-account",
      "label": "show-manage-account",
      "type": "boolean"
    },
    {
      "name": "show-other-accounts",
      "label": "show-other-accounts",
      "type": "boolean"
    },
    {
      "name": "show-edit-accounts",
      "label": "show-edit-accounts",
