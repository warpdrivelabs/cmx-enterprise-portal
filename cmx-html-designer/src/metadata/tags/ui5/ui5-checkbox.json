{
  "eventPreset": "ui5Form",
  "styleGroups": [
    "layout",
    "flex",
    "text",
    "box",
    "position"
  ],
  "label": "<ui5-checkbox>",
  "defaults": {
    "attributes": {
      "text": "复选框"
    }
  },
  "isVoid": true,
  "tag": "ui5-checkbox",
  "description": "UI5 复选框",
  "canNest": false,
  "group": "ui5",
  "attrs": [
    {
      "name": "accessible-name-ref",
      "label": "accessible-name-ref",
      "type": "text",
      "placeholder": "关联元素ID"
    },
    {
      "name": "accessible-name",
      "label": "accessible-name",
      "type": "text",
      "placeholder": "无障碍名称"
    },
    {
      "name": "disabled",
      "label": "disabled",
      "type": "boolean"
    },
    {
      "name": "readonly",
      "label": "readonly",
      "type": "boolean"
    },
    {
      "name": "display-only",
      "label": "display-only",
      "type": "boolean"
    },
    {
      "name": "required",
      "label": "required",
      "type": "boolean"
    },
    {
      "name": "indeterminate",
      "label": "indeterminate",
      "type": "boolean"
    },
    {
      "name": "checked",
      "label": "checked",
      "type": "boolean"
    },
    {
      "name": "text",
      "label": "text",
      "type": "text",
      "placeholder": ""
    },
    {
      "name": "value-state",
      "label": "value-state",
      "type": "select",
      "options": [
        "None",
        "Positive",
        "Critical",
        "Negative",
        "Information"
      ]
    },
    {
      "name": "wrapping-type",
      "label": "wrapping-type",
      "type": "select",
      "options": [
        "None",
        "Normal"
      ]
    },
    {
      "name": "name",
      "label": "name",
      "type": "text",
      "placeholder": ""
    },
    {
      "name": "value",
      "label": "value",
      "type": "text",
      "placeholder": ""
    }
  ],
  "slots": [],
  "extraEvents": [
    "change",
    "value-changed"
  ]
}