    {
      "name": "accessible-role",
      "label": "accessible-role",
      "type": "select",
      "options": [
        "Link",
        "Button"
      ]
    },
    {
      "name": "accessible-description",
      "label": "accessible-description",
      "type": "text",
      "placeholder": "无障碍描述"
    },
    {
      "name": "icon",
      "label": "icon",
      "type": "text",
      "placeholder": "sap-icon://add"
    },
    {
      "name": "end-icon",
      "label": "end-icon",
      "type": "text",
      "placeholder": ""
