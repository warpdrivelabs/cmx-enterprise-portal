    "text": "UI5 链接",
    "attributes": {
      "href": "#"
    }
  },
  "isVoid": false,
  "tag": "ui5-link",
  "description": "UI5 链接",
  "canNest": false,
  "group": "ui5",
  "attrs": [
    {
      "name": "disabled",
      "label": "disabled",
