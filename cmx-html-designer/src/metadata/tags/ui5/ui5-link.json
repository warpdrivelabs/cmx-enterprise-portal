      "placeholder": "提示文本"
    },
    {
      "name": "href",
      "label": "href",
      "type": "text",
      "placeholder": ""
    },
    {
      "name": "target",
      "label": "target",
      "type": "text",
      "placeholder": ""
    },
    {
      "name": "design",
      "label": "design",
      "type": "select",
      "options": [
        "Default",
        "Subtle",
        "Emphasized"
      ]
    },
    {
      "name": "interactive-area-size",
      "label": "interactive-area-size",
      "type": "select",
      "options": [
        "Normal",
        "Large"
      ]
    },
    {
      "name": "wrapping-type",
      "label": "wrapping-type",
      "type": "select",
