{
  "eventPreset": "ui5",
  "styleGroups": [
    "layout",
    "flex",
    "text",
    "box",
    "position"
  ],
  "label": "<ui5-list>",
  "isVoid": false,
  "tag": "ui5-list",
  "description": "UI5 列表",
  "canNest": true,
  "group": "ui5",
  "attrs": [
    {
      "name": "header-text",
      "label": "header-text",
      "type": "text",
      "placeholder": ""
    },
    {
      "name": "footer-text",
      "label": "footer-text",
      "type": "text",
      "placeholder": ""
    },
    {
      "name": "indent",
      "label": "indent",
      "type": "boolean"
    },
    {
      "name": "selection-mode",
      "label": "selection-mode",
      "type": "select",
      "options": [
        "None",
        "Single",
        "SingleStart",
        "SingleEnd",
        "SingleAuto",
        "Multiple",
        "Delete"
      ]
    },
    {
      "name": "no-data-text",
      "label": "no-data-text",
      "type": "text",
      "placeholder": ""
    },
    {
      "name": "separators",
      "label": "separators",
      "type": "select",
      "options": [
        "All",
        "Inner",
        "None"
      ]
    },
    {
      "name": "growing",
      "label": "growing",
      "type": "select",
      "options": [
        "Button",
        "Scroll",
        "None"
      ]
    },
    {
      "name": "growing-button-text",
      "label": "growing-button-text",
      "type": "text",
      "placeholder": ""
    },
    {
      "name": "loading",
      "label": "loading",
      "type": "boolean"
    },
    {
      "name": "loading-delay",
      "label": "loading-delay",
      "type": "text",
      "placeholder": "1000"
    },
    {
      "name": "sticky-header",
      "label": "sticky-header",
      "type": "boolean"
    },
    {
      "name": "accessible-name",
      "label": "accessible-name",
      "type": "text",
      "placeholder": "无障碍名称"
    },
    {
      "name": "accessible-name-ref",
      "label": "accessible-name-ref",
      "type": "text",
      "placeholder": "关联元素ID"
    },
    {
      "name": "accessible-description",
      "label": "accessible-description",
      "type": "text",
      "placeholder": "无障碍描述"
    },
    {
      "name": "accessible-description-ref",
      "label": "accessible-description-ref",
      "type": "text",
      "placeholder": ""
    },
    {
      "name": "accessible-role",
      "label": "accessible-role",
      "type": "select",
      "options": [
        "List",
        "Menu",
        "Tree",
        "ListBox"
      ]
    }
  ],
  "slots": [
    "",
    "header"
  ],
  "extraEvents": [
    "item-click",
    "item-close",
    "item-toggle",
    "item-delete",
    "selection-change",
    "load-more",
    "item-focused",
    "move-over",
    "move"
  ]
}