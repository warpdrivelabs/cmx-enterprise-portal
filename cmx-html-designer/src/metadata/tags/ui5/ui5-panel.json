{
  "eventPreset": "ui5",
  "styleGroups": [
    "layout",
    "flex",
    "text",
    "box",
    "position"
  ],
  "label": "<ui5-panel>",
  "defaults": {
    "attributes": {
      "header-text": "面板标题"
    }
  },
  "isVoid": false,
  "tag": "ui5-panel",
  "description": "UI5 面板",
  "canNest": true,
  "group": "ui5",
  "attrs": [
    {
      "name": "header-text",
      "label": "header-text",
      "type": "text",
      "placeholder": ""
    },
    {
      "name": "fixed",
      "label": "fixed",
      "type": "boolean"
    },
    {
      "name": "collapsed",
      "label": "collapsed",
      "type": "boolean"
    },
    {
      "name": "no-animation",
      "label": "no-animation",
      "type": "boolean"
    },
    {
      "name": "accessible-role",
      "label": "accessible-role",
      "type": "select",
      "options": [
        "Complementary",
        "Form",
        "Region"
      ]
    },
    {
      "name": "header-level",
      "label": "header-level",
      "type": "select",
      "options": [
        "H1",
        "H2",
        "H3",
        "H4",
        "H5",
        "H6"
      ]
    },
    {
      "name": "accessible-name",
      "label": "accessible-name",
      "type": "text",
      "placeholder": "无障碍名称"
    },
    {
      "name": "sticky-header",
      "label": "sticky-header",
      "type": "boolean"
    }
  ],
  "slots": [
    "header"
  ],
  "extraEvents": []
}