{
  "eventPreset": "ui5Form",
  "styleGroups": [
    "layout",
    "flex",
    "text",
    "box",
    "position"
  ],
  "label": "<ui5-date-picker>",
  "defaults": {},
  "isVoid": true,
  "tag": "ui5-date-picker",
  "description": "UI5 日期选择",
  "canNest": false,
  "group": "ui5",
  "attrs": [
    {
      "name": "value",
      "label": "value",
      "type": "text",
      "placeholder": ""
    },
    {
      "name": "value-state",
      "label": "value-state",
      "type": "select",
      "options": [
        "None",
        "Positive",
        "Critical",
        "Negative",
        "Information"
      ]
    },
    {
      "name": "required",
      "label": "required",
      "type": "boolean"
    },
    {
      "name": "disabled",
      "label": "disabled",
      "type": "boolean"
    },
    {
      "name": "readonly",
      "label": "readonly",
      "type": "boolean"
    },
    {
      "name": "placeholder",
      "label": "placeholder",
      "type": "text",
      "placeholder": "请输入..."
    },
    {
      "name": "name",
      "label": "name",
      "type": "text",
      "placeholder": ""
    },
    {
      "name": "hide-week-numbers",
      "label": "hide-week-numbers",
      "type": "boolean"
    },
    {
      "name": "open",
      "label": "open",
      "type": "boolean"
    },
    {
      "name": "accessible-name",
      "label": "accessible-name",
      "type": "text",
      "placeholder": "无障碍名称"
    },
    {
      "name": "accessible-name-ref",
      "label": "accessible-name-ref",
      "type": "text",
      "placeholder": "关联元素ID"
    },
    {
      "name": "accessible-description",
      "label": "accessible-description",
      "type": "text",
      "placeholder": "无障碍描述"
    },
    {
      "name": "accessible-description-ref",
      "label": "accessible-description-ref",
      "type": "text",
      "placeholder": ""
    },
    {
      "name": "show-clear-icon",
      "label": "show-clear-icon",
      "type": "boolean"
    }
  ],
  "slots": [
    "valueStateMessage"
  ],
  "extraEvents": []
}