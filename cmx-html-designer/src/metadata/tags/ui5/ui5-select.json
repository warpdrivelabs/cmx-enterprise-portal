{
  "eventPreset": "ui5Form",
  "styleGroups": [
    "layout",
    "flex",
    "text",
    "box",
    "position"
  ],
  "label": "<ui5-select>",
  "isVoid": false,
  "tag": "ui5-select",
  "description": "UI5 下拉框",
  "canNest": true,
  "group": "ui5",
  "attrs": [
    {
      "name": "disabled",
      "label": "disabled",
      "type": "boolean"
    },
    {
      "name": "name",
      "label": "name",
      "type": "text",
      "placeholder": ""
    },
    {
      "name": "value-state",
      "label": "value-state",
      "type": "select",
      "options": [
        "None",
        "Positive",
        "Critical",
        "Negative",
        "Information"
      ]
    },
    {
      "name": "required",
      "label": "required",
      "type": "boolean"
    },
    {
      "name": "readonly",
      "label": "readonly",
      "type": "boolean"
    },
    {
      "name": "accessible-name",
      "label": "accessible-name",
      "type": "text",
      "placeholder": "无障碍名称"
    },
    {
      "name": "accessible-name-ref",
      "label": "accessible-name-ref",
      "type": "text",
      "placeholder": "关联元素ID"
    },
    {
      "name": "accessible-description",
      "label": "accessible-description",
      "type": "text",
      "placeholder": "无障碍描述"
    },
    {
      "name": "accessible-description-ref",
      "label": "accessible-description-ref",
      "type": "text",
      "placeholder": ""
    },
    {
      "name": "tooltip",
      "label": "tooltip",
      "type": "text",
      "placeholder": "提示文本"
    },
    {
      "name": "text-separator",
      "label": "text-separator",
      "type": "select",
      "options": [
        "Bullet",
        "Dash",
        "VerticalLine"
      ]
    }
  ],
  "slots": [
    "",
    "valueStateMessage",
    "label"
  ],
  "extraEvents": [
    "change",
    "live-change",
    "open",
    "close",
    "selected-item-changed",
    "input"
  ]
}