# 生产构建专用环境变量（vite build 时 mode=production 自动加载）
#
# 同源托管到后端 /portal/ 路径下（cmx-container dev.toml [portal] web_portal_dist 配置）
# 访问：http://<host>:8080/portal/
#
# 部署到其他路径只需改本文件，如 nginx 反代到 /cmx-portal/：
#   CMX_APP_BASE=/cmx-portal/

CMX_APP_BASE=/portal/

# 路由模式：history（后端已配 SPA fallback）
# 若部署到无后端 fallback 的纯静态环境（如 CDN/S3），改为 hash 即可
VITE_ROUTER_MODE=history

# 后端 API 基础地址（留空 = 同源，前后端同站托管时无需配置）。
# 若前后端不同源部署（前端在 A 域，后端在 B 域，无法用 nginx 反代），设为后端地址：
#   VITE_API_BASE=https://api.example.com
VITE_API_BASE=

