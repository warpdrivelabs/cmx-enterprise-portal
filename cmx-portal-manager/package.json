{
  "name": "cmx-portal-manager",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "^18.0.0 || ^20.0.0 || >=22.0.0"
  },
  "scripts": {
    "dev": "node scripts/run-vite.mjs",
    "build": "npm run build -w cmx-ui5-runtime && node scripts/run-vite.mjs build",
    "preview": "node scripts/run-vite.mjs preview",
    "_comment_build": "多环境构建示例：新建 .env.<mode> 文件（如 .env.docker），用 --mode 指定。vite 按模式自动加载对应 .env 文件。例：\"build:docker\": \"node scripts/run-vite.mjs build --mode docker\"",
    "_deprecated_note": "后端已迁移到 cmx-container (Rust, :8080)。下面的 legacy:* 是停用的 Node 后端，仅作备份参考，正常不应启动。",
    "legacy:start": "node cmx-node-server/portalManagerService.js",
    "legacy:dev:server": "node --watch cmx-node-server/portalManagerService.js",
    "inventory:modules": "node cmx-node-server/tools/inventory-modules.mjs",
    "inventory:modules:json": "node cmx-node-server/tools/inventory-modules.mjs --write-json",
    "mockoon:generate": "node cmx-node-server/mockoon/generate-env.mjs",
    "mockoon:validate": "mockoon-cli validate --data cmx-node-server/mockoon/cmx-portal-api.json",
    "mockoon:start": "mockoon-cli start --data cmx-node-server/mockoon/cmx-portal-api.json --watch",
    "mockoon": "npm run mockoon:generate && npm run mockoon:start",
    "lint": "eslint \"src/**/*.js\" vite.config.js"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/state": "^6.4.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.41.1",
    "@fastify/compress": "^9.0.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/static": "^9.0.0",
    "@fastify/websocket": "^11.0.1",
    "@grpc/grpc-js": "^1.12.4",
    "@grpc/proto-loader": "^0.7.13",
    "@trpc/server": "^11.0.0",
    "@ui5/webcomponents": "^2.23.2",
    "@ui5/webcomponents-base": "^2.23.2",
    "@ui5/webcomponents-fiori": "^2.23.2",
    "@ui5/webcomponents-icons": "^2.23.2",
    "@ui5/webcomponents-icons-business-suite": "^2.23.2",
    "@ui5/webcomponents-icons-tnt": "^2.23.2",
    "@ui5/webcomponents-localization": "^2.23.2",
    "@ui5/webcomponents-theming": "^2.23.2",
    "cmx-data-comp": "*",
    "cmx-icon-resource": "*",
    "cmx-shared": "*",
    "cmx-ui5-runtime": "*",
    "codemirror": "^6.0.2",
    "fastify": "^5.2.1",
    "lit": "^3.2.1",
    "markdown-it": "^14.3.0",
    "shiki": "^1.29.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "vite": "^8.0.0"
  }
}
